# Cloudflare Pages header rules (ignored by GitHub Pages).
/*
  Content-Signal: search=yes, ai-input=yes, ai-train=yes
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=300, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=300, stale-while-revalidate=86400

/index.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: public, max-age=300, stale-while-revalidate=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/style.css
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Pragma: no-cache

/stats.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Pragma: no-cache

/assets/fonts/fonts.css
  Cache-Control: no-store, max-age=0, must-revalidate

# restore-home-cache
# jump-restore-1789257764

# AZindex discovery surfaces
/*
  Content-Signal: search=yes, ai-input=yes, ai-train=yes

/ai.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/cite.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/openapi.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/mcp.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/mcp.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# AZindex identity machine — never SPA HTML
/person.jsonld
  Content-Type: application/ld+json; charset=utf-8
  Cache-Control: public, max-age=3600

/identity.jsonld
  Content-Type: application/ld+json; charset=utf-8
  Cache-Control: public, max-age=3600

/graph.jsonld
  Content-Type: application/ld+json; charset=utf-8
  Cache-Control: public, max-age=3600

/who-is-aziel-eliab.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/aziel.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
/who-is
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Motion plate MP4s — never cache HTML mistakes long
/assets/video/*.mp4
  Content-Type: video/mp4
  Cache-Control: public, max-age=300, must-revalidate
  Accept-Ranges: bytes

# Dynamic meters — do not CDN-cache
/api/*
  Cache-Control: no-store
